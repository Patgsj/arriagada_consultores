RewriteEngine On

# Canonicalizar host y protocolo en una sola redirección (HTTPS + sin www).
# Antes: www.arriagadaconsultores.cl respondía 200 sin redirigir (host duplicado).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://arriagadaconsultores.cl/$1 [L,R=301]

# La home vive en "/" y en ninguna otra URL.
# Antes: /index.html redirigía a /index, que respondía 200 (home duplicada).
RewriteCond %{THE_REQUEST} \s/index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# URLs retiradas. Van antes de las reglas de URL limpia para que no las
# intercepte el 301 de .html.
#
# /blog era la cáscara del blog que nunca se escribió: 4 tarjetas con href="#"
# y ninguna página detrás. Llevaba noindex desde el 18-08, pero Google no volvía
# a rastrearla (no la enlazaba nada) y seguía indexada. El 410 es la señal para
# que la suelte, y funciona aunque el archivo siga en el servidor.
RewriteRule ^blog(\.html)?/?$ - [G,L]

# Propiedad que ya no se publica. El 301 conserva los enlaces externos que
# apunten ahí y deja a la persona en el listado en vez de en un 404.
RewriteRule ^oportunidad-de-inversion(\.html)?/?$ /venta-propiedades [R=301,L]

# Redirigir URLs con .html a URLs limpias (301)
RewriteCond %{THE_REQUEST} \s(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Servir archivos .html cuando se accede sin extensión
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]

# Archivos de build que no tienen por qué ser públicos.
<FilesMatch "^(package(-lock)?\.json|tailwind\.config\.js|postcss\.config\.js)$">
  Require all denied
</FilesMatch>

# Caché de estáticos. Antes no se enviaba ninguna cabecera de caché:
# cada visita repetida volvía a descargar CSS, JS e imágenes completos.
#
# Ojo con la distinción: el deploy es por FTP y NO renombra los archivos, así
# que nada acá lleva huella en el nombre. Las imágenes y fuentes casi no cambian
# (y cuando cambian, cambia también su nombre), así que aguantan un año. El CSS
# y el JS sí cambian en cada deploy conservando el nombre: con un año de caché,
# quien ya hubiera visitado el sitio se quedaba con el main.js viejo y no veía
# ningún cambio. Van con revalidación: el navegador pregunta y recibe un 304 si
# no cambió, que cuesta casi lo mismo que no preguntar.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 0 seconds"
  ExpiresByType application/javascript    "access plus 0 seconds"
  ExpiresByType text/javascript           "access plus 0 seconds"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2|JPG)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # CSS, JS y HTML se revalidan siempre: el deploy por FTP no cambia el nombre
  # del archivo, así que la única forma de que el navegador vea un cambio es
  # que pregunte.
  <FilesMatch "\.(css|js|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
